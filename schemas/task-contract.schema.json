{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/calvinnwq/staffbench/blob/main/schemas/task-contract.schema.json",
  "title": "StaffBench Task Ledger",
  "description": "Public contract for measurable, replayable StaffBench role tasks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "benchmark_id",
    "benchmark_version",
    "status",
    "evaluation_policy",
    "roles",
    "tasks"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schemas/task-contract.schema.json"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "benchmark_id": {
      "type": "string",
      "const": "staffbench"
    },
    "benchmark_version": {
      "type": "string",
      "const": "0.5.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "contract-draft",
        "fixture-ready",
        "benchmark-ready"
      ]
    },
    "evaluation_policy": {
      "$ref": "#/$defs/evaluation_policy"
    },
    "roles": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "evaluation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_boundary",
        "live_web",
        "default_allowed_tools",
        "score_order",
        "human_scale",
        "provenance_values",
        "status_values"
      ],
      "properties": {
        "execution_boundary": {
          "type": "string",
          "const": "offline_replay"
        },
        "live_web": {
          "type": "boolean",
          "const": false
        },
        "default_allowed_tools": {
          "type": "array",
          "const": [],
          "items": {
            "type": "string"
          }
        },
        "score_order": {
          "type": "array",
          "const": [
            "hard_failures",
            "automatic_checks",
            "human_dimensions"
          ],
          "items": {
            "type": "string",
            "enum": [
              "hard_failures",
              "automatic_checks",
              "human_dimensions"
            ]
          }
        },
        "human_scale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "maximum",
            "anchors"
          ],
          "properties": {
            "minimum": {
              "type": "integer",
              "const": 0
            },
            "maximum": {
              "type": "integer",
              "const": 4
            },
            "anchors": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "0",
                "2",
                "4"
              ],
              "properties": {
                "0": {
                  "type": "string",
                  "minLength": 1
                },
                "2": {
                  "type": "string",
                  "minLength": 1
                },
                "4": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "provenance_values": {
          "type": "array",
          "const": [
            "synthetic"
          ],
          "items": {
            "type": "string"
          }
        },
        "status_values": {
          "type": "array",
          "const": [
            "contract-draft",
            "fixture-ready",
            "benchmark-ready"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "name",
        "tag",
        "mission",
        "task_ids",
        "primary_dimensions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "enum": [
            "cos",
            "fin",
            "eng",
            "trv",
            "fit",
            "res",
            "ops",
            "prd",
            "des"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "mission": {
          "type": "string",
          "minLength": 1
        },
        "task_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        },
        "primary_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "status",
        "source_policy",
        "live_web",
        "allowed_tools",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*-v[0-9]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "to_be_frozen",
            "frozen"
          ]
        },
        "source_policy": {
          "type": "string",
          "enum": [
            "public_synthetic"
          ]
        },
        "live_web": {
          "type": "boolean",
          "const": false
        },
        "allowed_tools": {
          "type": "array",
          "const": [],
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prompt_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "input_description",
        "required_output_format",
        "required_output_fields",
        "output_constraints"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "to_be_frozen",
            "frozen"
          ]
        },
        "input_description": {
          "type": "string",
          "minLength": 1
        },
        "required_output_format": {
          "type": "string",
          "enum": [
            "json",
            "repository_change",
            "structured_markdown"
          ]
        },
        "required_output_fields": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "output_constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "automatic_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "description",
        "pass_condition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "pass_condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "human_dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "weight",
        "anchors"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "anchors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "0",
            "2",
            "4"
          ],
          "properties": {
            "0": {
              "type": "string",
              "minLength": 1
            },
            "2": {
              "type": "string",
              "minLength": 1
            },
            "4": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "hard_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "condition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_type",
        "automatic_checks",
        "human_dimensions",
        "hard_failures"
      ],
      "properties": {
        "primary_type": {
          "type": "string",
          "enum": [
            "objective",
            "hybrid",
            "rubric"
          ]
        },
        "automatic_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/automatic_check"
          }
        },
        "human_dimensions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/human_dimension"
          }
        },
        "hard_failures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hard_failure"
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role_id",
        "sequence",
        "title",
        "task_family",
        "provenance",
        "provenance_note",
        "privacy_class",
        "status",
        "fixture",
        "prompt_contract",
        "measurement",
        "known_failure_modes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{2}$",
          "enum": [
            "COS-01",
            "COS-02",
            "FIN-01",
            "FIN-02",
            "ENG-01",
            "ENG-02",
            "TRV-01",
            "TRV-02",
            "FIT-01",
            "FIT-02",
            "RES-01",
            "RES-02",
            "OPS-01",
            "OPS-02",
            "PRD-01",
            "PRD-02",
            "DES-01",
            "DES-02"
          ]
        },
        "role_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "sequence": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "task_family": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "enum": [
            "synthetic"
          ]
        },
        "provenance_note": {
          "type": "string",
          "minLength": 1
        },
        "privacy_class": {
          "type": "string",
          "enum": [
            "public_synthetic"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "contract-draft",
            "fixture-ready",
            "benchmark-ready"
          ]
        },
        "fixture": {
          "$ref": "#/$defs/fixture"
        },
        "prompt_contract": {
          "$ref": "#/$defs/prompt_contract"
        },
        "measurement": {
          "$ref": "#/$defs/measurement"
        },
        "known_failure_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
